rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY: the web app never talks to Firestore directly - every read and
    // write goes through the Cloud Functions API, which uses the Admin SDK and
    // is not affected by these rules. Deny all direct client access so nobody
    // can read users/wallets or forge deals with the public Firebase API key.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
